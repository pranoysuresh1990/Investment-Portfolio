# Copy this file to .streamlit/secrets.toml and fill in your own values.
# .streamlit/secrets.toml is gitignored -- it will never be committed.
#
# On Streamlit Community Cloud, you don't use this file directly -- instead
# paste the same two lines into your app's Settings -> Secrets box.

sheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
gcp_api_key = "YOUR_API_KEY"
